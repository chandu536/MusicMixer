<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/surface"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- ── Row 1: Drag handle + color dot + name + actions ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Drag handle (long-press triggers reorder) -->
            <ImageView
                android:id="@+id/iv_drag_handle"
                android:layout_width="22dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_drag_handle"
                android:tint="@color/text_hint"
                android:contentDescription="Drag to reorder"
                android:paddingEnd="4dp"/>

            <!-- Color strip -->
            <View
                android:id="@+id/view_color_bar"
                android:layout_width="3dp"
                android:layout_height="32dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_track_color_bar"/>

            <!-- Name + meta -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_track_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="1dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_hint"
                        android:textSize="10sp"/>

                    <TextView
                        android:id="@+id/tv_trim_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="@color/accent_alt"
                        android:textSize="10sp"
                        android:visibility="gone"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Play this clip -->
            <ImageButton
                android:id="@+id/btn_play_track"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_play"
                android:background="@drawable/bg_play_btn"
                android:tint="@color/white"
                android:padding="8dp"
                android:contentDescription="Play clip"/>

            <!-- Delete -->
            <ImageButton
                android:id="@+id/btn_remove"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_delete"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="@color/danger"
                android:contentDescription="Remove"/>

        </LinearLayout>

        <!-- ── Row 2: Waveform — trim handles ── -->
        <com.musicmixer.app.ui.editor.TrimWaveformView
            android:id="@+id/trim_waveform"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="8dp"
            android:background="@color/bg"/>

        <!-- Time row: trim-start label | live timer (center) | trim-end label -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:gravity="center_vertical">

            <!-- Trim start timestamp (always visible) -->
            <TextView
                android:id="@+id/tv_trim_start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/accent_alt"
                android:textSize="9sp"
                android:fontFamily="monospace"/>

            <!-- Live position while playing: "1:05.000 / 2:10.000" -->
            <TextView
                android:id="@+id/tv_playback_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingVertical="2dp"
                android:paddingHorizontal="8dp"
                android:text=""
                android:textColor="@color/white"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:background="@drawable/bg_timer_pill"
                android:visibility="gone"/>

            <!-- Trim end timestamp (always visible) -->
            <TextView
                android:id="@+id/tv_trim_end"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/accent"
                android:textSize="9sp"
                android:fontFamily="monospace"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
