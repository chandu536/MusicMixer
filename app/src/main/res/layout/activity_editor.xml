<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    tools:context=".ui.editor.EditorActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_dark"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/bg_dark"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/text_primary"
            app:title="@string/editor_title"
            app:titleTextColor="@color/text_primary"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"/>

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Track name header -->
        <TextView
            android:id="@+id/tv_track_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:ellipsize="end"
            android:maxLines="1"/>

        <!-- Duration info bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tv_original_duration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:text="Original: —"/>

            <TextView
                android:id="@+id/tv_selected_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:text="Selected: —"/>

        </LinearLayout>

        <!-- Waveform + trim view (scrollable) -->
        <HorizontalScrollView
            android:id="@+id/scroll_waveform"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:scrollbars="none"
            android:fillViewport="true"
            android:background="@color/surface"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent">

                <!-- Waveform -->
                <com.musicmixer.app.ui.editor.TrimWaveformView
                    android:id="@+id/trim_waveform"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"/>

            </FrameLayout>
        </HorizontalScrollView>

        <!-- Time labels under waveform -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/tv_time_start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00.000"
                android:textColor="@color/text_hint"
                android:textSize="10sp"/>

            <TextView
                android:id="@+id/tv_time_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00.000"
                android:textColor="@color/text_hint"
                android:textSize="10sp"/>

        </LinearLayout>

        <!-- Divider -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/divider" android:layout_marginBottom="16dp"/>

        <!-- Trim Start -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="▶  Trim Start"
                    android:textColor="@color/accent_alt"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"/>

                <TextView
                    android:id="@+id/tv_trim_start_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00.000"
                    android:textColor="@color/accent_alt"
                    android:textSize="13sp"
                    android:fontFamily="monospace"/>

            </LinearLayout>

            <SeekBar
                android:id="@+id/sb_trim_start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="1000"
                android:progress="0"
                android:progressTint="@color/accent_alt"
                android:thumbTint="@color/accent_alt"/>

        </LinearLayout>

        <!-- Trim End -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="■  Trim End"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"/>

                <TextView
                    android:id="@+id/tv_trim_end_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00.000"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:fontFamily="monospace"/>

            </LinearLayout>

            <SeekBar
                android:id="@+id/sb_trim_end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="1000"
                android:progress="1000"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent"/>

        </LinearLayout>

        <!-- Divider -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/divider" android:layout_marginBottom="16dp"/>

        <!-- Preview + Reset -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_preview"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="▶  Preview"
                android:textColor="@color/primary"
                app:strokeColor="@color/primary"
                app:cornerRadius="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reset_trim"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="↩  Reset"
                android:textColor="@color/text_secondary"
                app:strokeColor="@color/divider"
                app:cornerRadius="12dp"/>

        </LinearLayout>

        <!-- Apply button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_apply"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:text="✓  Apply Trim"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:backgroundTint="@color/primary"
            app:cornerRadius="14dp"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
