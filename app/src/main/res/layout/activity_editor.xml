<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    tools:context=".ui.editor.EditorActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_dark"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/bg_dark"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/text_primary"
            app:title="@string/editor_title"
            app:titleTextColor="@color/text_primary"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"/>

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- ── Track name + duration row ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/tv_track_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:inputType="text"
                        android:background="@android:color/transparent"
                        android:hint="Clip name"
                        android:textColorHint="@color/text_hint"
                        android:imeOptions="actionDone"
                        android:padding="0dp"/>

                    <TextView
                        android:id="@+id/tv_original_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp"
                        android:text="Original: —"/>

                </LinearLayout>

                <!-- Selected duration badge -->
                <TextView
                    android:id="@+id/tv_selected_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Selected: —"
                    android:textColor="@color/primary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/bg_timer_pill"/>

            </LinearLayout>

            <!-- ── Large Waveform ── -->
            <com.musicmixer.app.ui.editor.TrimWaveformView
                android:id="@+id/trim_waveform"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@color/surface"/>

            <!-- Preview timer under waveform -->
            <TextView
                android:id="@+id/tv_preview_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="3dp"
                android:text=""
                android:textColor="@color/white"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:background="@drawable/bg_timer_pill"
                android:visibility="gone"/>

            <!-- ── Divider ── -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"/>

            <!-- ══════════════════════════════════════════
                 TRIM START SECTION
                 ══════════════════════════════════════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="▶  Trim Start"
                android:textColor="@color/accent_alt"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"/>

            <!-- Start time fields: [mm] : [ss] . [ms]  ±buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center_vertical">

                <!-- mm:ss.ms fields -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@color/surface"
                    android:padding="6dp">

                    <EditText
                        android:id="@+id/et_start_min"
                        android:layout_width="32dp"
                        android:layout_height="36dp"
                        android:inputType="number"
                        android:maxLength="2"
                        android:gravity="center"
                        android:textColor="@color/accent_alt"
                        android:textSize="14sp"
                        android:fontFamily="monospace"
                        android:background="@android:color/transparent"
                        android:hint="00"
                        android:textColorHint="@color/text_hint"
                        android:padding="0dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text=":" android:textColor="@color/text_secondary" android:textSize="16sp"/>

                    <EditText
                        android:id="@+id/et_start_sec"
                        android:layout_width="32dp"
                        android:layout_height="36dp"
                        android:inputType="number"
                        android:maxLength="2"
                        android:gravity="center"
                        android:textColor="@color/accent_alt"
                        android:textSize="14sp"
                        android:fontFamily="monospace"
                        android:background="@android:color/transparent"
                        android:hint="00"
                        android:textColorHint="@color/text_hint"
                        android:padding="0dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="." android:textColor="@color/text_secondary" android:textSize="16sp"/>

                    <EditText
                        android:id="@+id/et_start_ms"
                        android:layout_width="40dp"
                        android:layout_height="36dp"
                        android:inputType="number"
                        android:maxLength="3"
                        android:gravity="center"
                        android:textColor="@color/accent_alt"
                        android:textSize="14sp"
                        android:fontFamily="monospace"
                        android:background="@android:color/transparent"
                        android:hint="000"
                        android:textColorHint="@color/text_hint"
                        android:padding="0dp"/>

                </LinearLayout>

                <!-- Step buttons for start -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginStart="8dp"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_start_minus5"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="-5s"
                        android:textSize="10sp"
                        android:textColor="@color/accent_alt"
                        app:strokeColor="@color/accent_alt"
                        app:cornerRadius="6dp"
                        android:layout_marginEnd="3dp"
                        android:minWidth="0dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_start_minus1"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="-1s"
                        android:textSize="10sp"
                        android:textColor="@color/accent_alt"
                        app:strokeColor="@color/accent_alt"
                        app:cornerRadius="6dp"
                        android:layout_marginEnd="3dp"
                        android:minWidth="0dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_start_minus01"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="-.1s"
                        android:textSize="10sp"
                        android:textColor="@color/accent_alt"
                        app:strokeColor="@color/accent_alt"
                        app:cornerRadius="6dp"
                        android:layout_marginEnd="3dp"
                        android:minWidth="0dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_start_plus01"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="+.1s"
                        android:textSize="10sp"
                        android:textColor="@color/accent_alt"
                        app:strokeColor="@color/accent_alt"
                        app:cornerRadius="6dp"
                        android:layout_marginEnd="3dp"
                        android:minWidth="0dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_start_plus1"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="+1s"
                        android:textSize="10sp"
                        android:textColor="@color/accent_alt"
                        app:strokeColor="@color/accent_alt"
                        app:cornerRadius="6dp"
                        android:layout_marginEnd="3dp"
                        android:minWidth="0dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_start_plus5"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="+5s"
                        android:textSize="10sp"
                        android:textColor="@color/accent_alt"
                        app:strokeColor="@color/accent_alt"
                        app:cornerRadius="6dp"
                        android:minWidth="0dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- ── Divider ── -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"/>

            <!-- ══════════════════════════════════════════
                 TRIM END SECTION
                 ══════════════════════════════════════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="■  Trim End"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"/>

            <!-- End time fields: [mm] : [ss] . [ms]  ±buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center_vertical">

                <!-- mm:ss.ms fields -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@color/surface"
                    android:padding="6dp">

                    <EditText
                        android:id="@+id/et_end_min"
                        android:layout_width="32dp"
                        android:layout_height="36dp"
                        android:inputType="number"
                        android:maxLength="2"
                        android:gravity="center"
                        android:textColor="@color/accent"
                        android:textSize="14sp"
                        android:fontFamily="monospace"
                        android:background="@android:color/transparent"
                        android:hint="00"
                        android:textColorHint="@color/text_hint"
                        android:padding="0dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text=":" android:textColor="@color/text_secondary" android:textSize="16sp"/>

                    <EditText
                        android:id="@+id/et_end_sec"
                        android:layout_width="32dp"
                        android:layout_height="36dp"
                        android:inputType="number"
                        android:maxLength="2"
                        android:gravity="center"
                        android:textColor="@color/accent"
                        android:textSize="14sp"
                        android:fontFamily="monospace"
                        android:background="@android:color/transparent"
                        android:hint="00"
                        android:textColorHint="@color/text_hint"
                        android:padding="0dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="." android:textColor="@color/text_secondary" android:textSize="16sp"/>

                    <EditText
                        android:id="@+id/et_end_ms"
                        android:layout_width="40dp"
                        android:layout_height="36dp"
                        android:inputType="number"
                        android:maxLength="3"
                        android:gravity="center"
                        android:textColor="@color/accent"
                        android:textSize="14sp"
                        android:fontFamily="monospace"
                        android:background="@android:color/transparent"
                        android:hint="000"
                        android:textColorHint="@color/text_hint"
                        android:padding="0dp"/>

                </LinearLayout>

                <!-- Step buttons for end -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginStart="8dp"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_end_minus5"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="-5s"
                        android:textSize="10sp"
                        android:textColor="@color/accent"
                        app:strokeColor="@color/accent"
                        app:cornerRadius="6dp"
                        android:layout_marginEnd="3dp"
                        android:minWidth="0dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_end_minus1"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="-1s"
                        android:textSize="10sp"
                        android:textColor="@color/accent"
                        app:strokeColor="@color/accent"
                        app:cornerRadius="6dp"
                        android:layout_marginEnd="3dp"
                        android:minWidth="0dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_end_minus01"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="-.1s"
                        android:textSize="10sp"
                        android:textColor="@color/accent"
                        app:strokeColor="@color/accent"
                        app:cornerRadius="6dp"
                        android:layout_marginEnd="3dp"
                        android:minWidth="0dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_end_plus01"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="+.1s"
                        android:textSize="10sp"
                        android:textColor="@color/accent"
                        app:strokeColor="@color/accent"
                        app:cornerRadius="6dp"
                        android:layout_marginEnd="3dp"
                        android:minWidth="0dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_end_plus1"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="+1s"
                        android:textSize="10sp"
                        android:textColor="@color/accent"
                        app:strokeColor="@color/accent"
                        app:cornerRadius="6dp"
                        android:layout_marginEnd="3dp"
                        android:minWidth="0dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_end_plus5"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="+5s"
                        android:textSize="10sp"
                        android:textColor="@color/accent"
                        app:strokeColor="@color/accent"
                        app:cornerRadius="6dp"
                        android:minWidth="0dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- ── Divider ── -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"/>

            <!-- ══════════════════════════════════════════
                 VOLUME SECTION
                 ══════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="4dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔊  Volume"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"/>

                <TextView
                    android:id="@+id/tv_volume_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:fontFamily="monospace"/>

            </LinearLayout>

            <SeekBar
                android:id="@+id/sb_volume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:max="150"
                android:progress="100"
                android:progressTint="@color/primary"
                android:thumbTint="@color/primary"/>

            <!-- ── Divider ── -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"/>

            <!-- ══════════════════════════════════════════
                 FADE TOGGLES
                 ══════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Fade Effects"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_fade_in"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Fade In"
                    android:textSize="11sp"
                    android:layout_marginEnd="8dp"
                    app:chipBackgroundColor="@color/surface"
                    app:chipStrokeWidth="1dp"
                    app:chipStrokeColor="@color/primary"
                    app:checkedIconVisible="true"
                    android:checkable="true"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_fade_out"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Fade Out"
                    android:textSize="11sp"
                    app:chipBackgroundColor="@color/surface"
                    app:chipStrokeWidth="1dp"
                    app:chipStrokeColor="@color/accent"
                    app:checkedIconVisible="true"
                    android:checkable="true"/>

            </LinearLayout>

            <!-- ── Divider ── -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"/>

            <!-- ══════════════════════════════════════════
                 DELAY SECTION
                 ══════════════════════════════════════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="⏱  Silence Delay (seconds)"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center_vertical">

                <!-- Before label + field -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Before:"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginEnd="6dp"/>

                <EditText
                    android:id="@+id/et_delay_before"
                    android:layout_width="80dp"
                    android:layout_height="36dp"
                    android:inputType="numberDecimal"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:background="@color/surface"
                    android:hint="0.000"
                    android:textColorHint="@color/text_hint"
                    android:padding="4dp"/>

                <!-- After label + field -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="After:"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="6dp"/>

                <EditText
                    android:id="@+id/et_delay_after"
                    android:layout_width="80dp"
                    android:layout_height="36dp"
                    android:inputType="numberDecimal"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:background="@color/surface"
                    android:hint="0.000"
                    android:textColorHint="@color/text_hint"
                    android:padding="4dp"/>

            </LinearLayout>

            <!-- ── Divider ── -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"/>

            <!-- ══════════════════════════════════════════
                 PLAYBACK SPEED
                 ══════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏩  Speed"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginEnd="10dp"/>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_speed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_speed_1_8"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="⅛×"
                        android:textSize="11sp"
                        android:checkable="true"
                        app:chipBackgroundColor="@color/surface"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/divider"
                        app:checkedIconVisible="false"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_speed_1_4"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="¼×"
                        android:textSize="11sp"
                        android:checkable="true"
                        app:chipBackgroundColor="@color/surface"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/divider"
                        app:checkedIconVisible="false"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_speed_1_2"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="½×"
                        android:textSize="11sp"
                        android:checkable="true"
                        app:chipBackgroundColor="@color/surface"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/divider"
                        app:checkedIconVisible="false"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_speed_1x"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="1×"
                        android:textSize="11sp"
                        android:checkable="true"
                        android:checked="true"
                        app:chipBackgroundColor="@color/surface"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/primary"
                        app:checkedIconVisible="false"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_speed_2x"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="2×"
                        android:textSize="11sp"
                        android:checkable="true"
                        app:chipBackgroundColor="@color/surface"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/divider"
                        app:checkedIconVisible="false"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_speed_3x"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="3×"
                        android:textSize="11sp"
                        android:checkable="true"
                        app:chipBackgroundColor="@color/surface"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/divider"
                        app:checkedIconVisible="false"/>

                </com.google.android.material.chip.ChipGroup>

            </LinearLayout>

            <!-- ── Divider ── -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="14dp"/>

            <!-- ══════════════════════════════════════════
                 PREVIEW + RESET + APPLY
                 ══════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_preview"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="▶  Preview"
                    android:textColor="@color/primary"
                    app:strokeColor="@color/primary"
                    app:cornerRadius="12dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_reset_trim"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="↩  Reset"
                    android:textColor="@color/text_secondary"
                    app:strokeColor="@color/divider"
                    app:cornerRadius="12dp"/>

            </LinearLayout>

            <!-- Apply button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_apply"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:text="✓  Apply Changes"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:backgroundTint="@color/primary"
                app:cornerRadius="14dp"/>

        </LinearLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
